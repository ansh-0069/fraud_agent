# Copy to apps/web/.env.local and fill in if you want real Groq LLM inference.
# Everything else works without any keys — the demo gracefully falls back to
# grounded templated responses that still reference real FDT simulation data.

GROQ_API_KEY=

# URL of the Python ML sidecar (real PyTorch LSTM, sklearn Isolation Forest,
# PPO policy). Optional — if unreachable, Next.js falls back to its built-in
# TypeScript Monte Carlo + heuristic anomaly scorer so the demo never breaks.
ML_SERVICE_URL=http://127.0.0.1:8000
